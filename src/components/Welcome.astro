---
import MotionScene from './MotionScene.astro';

const fieldNotePhoto = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/bernina-express`;

const navItems = [
  { label: 'Field note', href: '#field-note' },
  { label: 'Meet me', href: '#introduction' },
  { label: 'Hobbies', href: '#hobby' },
];

const facts = [
  { label: 'Favorite color', value: 'Ocean blue' },
  { label: 'Best snack', value: 'Fruit yogurt + crackers' },
];

const hobbies = [
  {
    title: 'Sports and outdoors',
    detail: 'Basketball, swimming, beach walks, and weekend bike rides.',
  },
  {
    title: 'Games and building',
    detail: 'LEGO builds, Minecraft creative mode, and puzzle challenges.',
  },
  {
    title: 'Space and science',
    detail: 'Space facts, science videos, and experiments at home.',
  },
];
---

<div class="vlog-page">
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header">
    <a class="logo" href="#hero" aria-label="TT Vlog home">
      <span class="logo__mark">TT</span>
      <span class="logo__text">Vlog OS</span>
    </a>
    <nav aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Light theme" aria-pressed="false">
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>
      </svg>
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.9 13.35A9 9 0 0 1 10.65 3.1a9 9 0 1 0 10.25 10.25Z"/>
      </svg>
    </button>
  </header>

  <main id="content" tabindex="-1">
    <section class="hero" id="hero">
      <div class="wrap hero__layout">
        <div class="hero__copy">
          <p class="eyebrow">Personal vlog · Age 11</p>
          <h1><span class="hero__word"><span>TT</span></span> <span class="hero__word"><span>Vlog</span></span></h1>
          <p class="hero__lead">I’m TT. This is where I write about my hobbies, the places I’d like to go, and the things I learn along the way.</p>
          <div class="hero__cta">
            <a class="cta cta--primary" href="#field-note">Read the latest note <span aria-hidden="true">↓</span></a>
            <a class="cta cta--secondary" href="#hobby">Explore hobbies</a>
          </div>
        </div>
        <MotionScene />
      </div>
    </section>

    <section class="field-note" id="field-note" aria-labelledby="field-note-title">
      <article class="wrap">
        <header class="field-note__header">
          <div>
            <p class="eyebrow">Field note 01 · Dream trip</p>
            <h2 id="field-note-title">Aquariums and <span class="field-note__accent">mountain</span> <span class="field-note__accent">trains</span></h2>
          </div>
          <p class="field-note__text">My dream trip has two stops: a train ride through the mountains and an afternoon at an aquarium. I’d bring my camera for both.</p>
        </header>
        <div class="field-note__frame">
          <img
            class="field-note__photo"
            src={`${fieldNotePhoto}-1536.webp`}
            srcset={`${fieldNotePhoto}-768.webp 768w, ${fieldNotePhoto}-1536.webp 1536w, ${fieldNotePhoto}-2304.webp 2304w`}
            sizes="(min-width: 1440px) 1288px, 88vw"
            width="1536"
            height="948"
            alt="A red Bernina Express train passing a frozen lake in the Swiss Alps"
            data-source="stand-in"
            data-subject="Bernina Express by Lago Bianco"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>
    </section>

    <section class="intro section-band" id="introduction">
      <div class="wrap intro__layout">
        <div class="section-copy">
          <p class="eyebrow">Profile scan</p>
          <h2>Meet TT</h2>
          <p>I like exploring new places, trying new food, and learning cool facts. I write short stories about my day and keep photos of special moments.</p>
        </div>
        <dl class="facts-grid" aria-label="Quick facts">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="hobby section-band" id="hobby">
      <div class="wrap">
        <header class="hobby__heading">
          <h2>Weekend hobbies</h2>
          <svg class="hobby__dial" viewBox="0 0 100 54" aria-hidden="true" fill="none" stroke-width="2" stroke-linecap="round">
            <path d="M8 47a42 42 0 0 1 84 0M16 28l5 3M50 15v6M84 28l-5 3"/>
            <path class="hobby__needle" d="M50 47V18"/>
            <circle cx="50" cy="47" r="3"/>
          </svg>
        </header>
        <div class="hobby__grid">
          {hobbies.map((item, index) => (
            <article class="hobby__card">
              <span class="hobby__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <a href="#hero">Back to top <span aria-hidden="true">↑</span></a>
      <span class="photo-credit">
        Photo: <a href="https://commons.wikimedia.org/wiki/File:RhB_ABe_8-12_with_Bernina_Express_at_Lago_Bianco.jpg">David Gubler</a>
        · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · resized
      </span>
    </div>
  </footer>
</div>

<script>
  const themeToggle = document.querySelector('[data-theme-toggle]');
  const root = document.documentElement;

  const syncThemeToggle = () => {
    themeToggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
  };

  themeToggle?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = nextTheme;
    syncThemeToggle();
    try {
      localStorage.setItem('theme', nextTheme);
    } catch {
      // Keep theme switching usable when persistence is unavailable.
    }
  });

  syncThemeToggle();
</script>

<style>
  :global(*) { box-sizing: border-box; }

  .vlog-page {
    --ink: #070b10;
    --panel: #101923;
    --text: #f3f7f4;
    --muted: #a8baba;
    --cyan: #27f0d0;
    --gold: #ffc84a;
    --coral: #ff6262;
    --line: #304744;
    --hero-dot: rgba(39, 240, 208, 0.24);
    --button-ink: #06110f;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --gutter: clamp(20px, 6vw, 76px);
    --measure: 1288px;
    --header-height: 80px;
    background: var(--ink);
    color: var(--text);
    font-family: system-ui, sans-serif;
  }
  :global(html[data-theme='light']) .vlog-page {
    --ink: #f3fafb;
    --panel: #e6f2f3;
    --text: #102330;
    --muted: #415d64;
    --cyan: #006e63;
    --gold: #8c5700;
    --coral: #c13c3c;
    --line: #acc9c6;
    --hero-dot: rgba(0, 110, 99, 0.28);
    --button-ink: #fff;
  }
  .wrap {
    width: min(calc(100% - 2 * var(--gutter)), var(--measure));
    margin-inline: auto;
  }
  a { color: inherit; }
  :is(a, button):focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
  main, section { scroll-margin-top: var(--header-height); }

  .skip-link {
    position: fixed;
    z-index: 2;
    top: 12px;
    left: var(--gutter);
    display: grid;
    place-items: center;
    min-height: 44px;
    padding-inline: 16px;
    border-radius: 8px;
    background: var(--cyan);
    color: var(--button-ink);
  }
  .skip-link:not(:focus) { clip-path: inset(50%); }
  .site-header {
    position: sticky;
    z-index: 1;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--header-height);
    padding: 8px max(var(--gutter), calc((100% - var(--measure)) / 2));
    border-bottom: 1px solid var(--line);
    background: var(--ink);
    font: 700 12px var(--mono);
  }
  .logo, nav a, .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    text-decoration: none;
  }
  .logo { gap: 10px; }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 44px;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--cyan);
    font-size: 16px;
  }
  .logo__text { text-transform: uppercase; }
  nav { display: flex; gap: 8px; }
  nav a { padding-inline: 12px; }
  nav a:hover, .site-footer a:hover {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .theme-toggle {
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
    color: var(--cyan);
    cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--cyan); }
  .theme-icon { width: 19px; height: 19px; }
  .theme-icon--moon,
  :global(html[data-theme='light']) .theme-icon--sun { display: none; }
  :global(html[data-theme='light']) .theme-icon--moon { display: block; }

  h1, h2, h3, p { margin: 0; }
  h1, h2 { line-height: 1.04; letter-spacing: -0.055em; }
  h1 { font-size: clamp(56px, 8vw, 112px); font-weight: 750; }
  .hero__word {
    display: inline-block;
    overflow: clip;
    vertical-align: top;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero__word > span { display: block; }
  .hero__word + .hero__word { color: var(--cyan); }
  h2 { font-size: clamp(36px, 5.2vw, 72px); }
  h3 { font-size: clamp(22px, 2.4vw, 30px); line-height: 1.15; letter-spacing: -0.035em; }
  .hero__lead, .section-copy > p:not(.eyebrow) {
    max-width: 46ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.65;
  }
  .eyebrow {
    margin-bottom: 16px;
    color: var(--cyan);
    font: 700 12px/1.5 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--header-height));
    padding-block: clamp(32px, 6vh, 72px);
    background: radial-gradient(ellipse at 74% 46%, color-mix(in srgb, var(--cyan) 10%, var(--panel)), var(--ink) 65%);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, var(--hero-dot) 1px, transparent 1.5px) center / 24px 24px;
    mask-image: radial-gradient(ellipse 53% 74% at 74% 46%, #000 24%, transparent 94%);
    pointer-events: none;
  }
  .hero__layout { position: relative; }
  .hero__layout, .intro__layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(28px, 5vw, 84px);
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 48px;
    padding-inline: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    font: 700 12px var(--mono);
    text-decoration: none;
  }
  .cta--primary { background: var(--cyan); border-color: var(--cyan); color: var(--button-ink); }
  .cta--secondary { background: transparent; border-color: transparent; }
  .cta:hover { border-color: var(--cyan); }
  .cta--primary:hover { background: color-mix(in srgb, var(--cyan) 90%, var(--text)); }
  .cta--secondary:hover { border-color: transparent; text-decoration: underline; text-underline-offset: 4px; }

  .section-band {
    display: grid;
    align-items: center;
    padding-block: clamp(64px, 11vh, 112px);
    border-top: 1px solid var(--line);
  }
  .field-note {
    padding-block: clamp(44px, 5vw, 72px);
    border-top: 1px solid var(--line);
  }
  .field-note__header {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: end;
    gap: 20px clamp(28px, 5vw, 72px);
    margin-bottom: clamp(24px, 3vw, 42px);
  }
  .field-note__header h2 {
    max-width: 17ch;
    font-size: clamp(34px, 4.7vw, 68px);
    font-weight: 650;
    text-wrap: balance;
  }
  .field-note__text {
    max-width: 36ch;
    color: var(--muted);
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.6;
  }
  .field-note__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 12 / 5;
    object-fit: cover;
    object-position: 50% 48%;
  }
  .intro { background: var(--panel); }
  .facts-grid {
    position: relative;
    margin: 0;
    padding-inline-start: 16px;
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }
  .facts-grid > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }
  dt { color: var(--muted); font: 700 12px var(--mono); }
  dd { margin: 0; font-size: clamp(18px, 2vw, 26px); font-weight: 600; }
  .hobby__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .hobby__dial {
    flex: none;
    width: clamp(54px, 10vw, 108px);
    stroke: var(--muted);
  }
  .hobby__needle {
    stroke: var(--gold);
    transform-origin: 50px 47px;
    transform: rotate(62deg);
  }
  .hobby__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }
  .hobby__card {
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }
  .hobby__index {
    display: block;
    margin-bottom: 22px;
    color: var(--gold);
    font: 700 12px var(--mono);
  }
  .hobby__card p { margin-top: 12px; color: var(--muted); line-height: 1.65; }
  .site-footer { border-top: 1px solid var(--line); }
  .site-footer .wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
    color: var(--muted);
    font: 700 12px var(--mono);
  }
  .site-footer .wrap > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .photo-credit { line-height: 1.5; }
  .photo-credit a { text-underline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > :not(h1) {
      animation: arrival 650ms cubic-bezier(.22, 1, .36, 1) both;
    }
    .hero__word > span { animation: word-arrival 700ms cubic-bezier(.22, 1, .36, 1) both; }
    .hero__word + .hero__word > span { animation-delay: 90ms; }
    .hero__copy > .hero__lead { animation-delay: 130ms; }
    .hero__copy > .hero__cta { animation-delay: 195ms; }
    .hero__copy:focus-within > *,
    .hero__copy:focus-within .hero__word > span { animation: none; }
    .cta { transition: transform 150ms, border-color 150ms, background 150ms; }
    .cta:active { transform: translateY(1px); }
    .cta--primary span { transition: transform 150ms; }
    .cta--primary:focus-visible span { transform: translateY(3px); }
    @media (hover: hover) and (pointer: fine) {
      .cta:hover:not(:active) { transform: translateY(-1px); }
      .cta--primary:hover span { transform: translateY(3px); }
    }

    @supports (animation-timeline: --note-entry) and (animation-range: entry 0% entry 75%) {
      .field-note {
        view-timeline: --note-entry block 24% 8%;
      }
      .field-note__frame { position: relative; }
      .field-note__frame::before {
        content: '';
        position: absolute;
        inset: auto 0 100%;
        height: 2px;
        background: var(--cyan);
        transform-origin: left;
        animation: note-rule 1ms linear both;
      }
      .field-note__accent { animation: note-accent 1ms linear both; }
      .field-note__frame::before, .field-note__accent {
        animation-timeline: --note-entry;
        animation-range: entry 0% entry 75%;
      }
      .field-note__accent { animation-range: entry 20% entry 48%; }
      .field-note__accent + .field-note__accent { animation-range: entry 40% entry 68%; }

      .intro { view-timeline: --profile-entry block 16% 8%; }
      .facts-grid::before {
        content: '';
        position: absolute;
        inset-block: 0;
        inset-inline-start: -1px;
        width: 2px;
        background: var(--cyan);
        transform-origin: top;
        animation: profile-scan 1ms linear both;
        animation-timeline: --profile-entry;
        animation-range: entry 12% entry 85%;
      }
      .facts-grid dt {
        animation: profile-label 1ms linear both;
        animation-timeline: --profile-entry;
        animation-range: entry 18% entry 45%;
      }
      .facts-grid div + div dt { animation-range: entry 53% entry 80%; }

      .hobby { view-timeline: --hobby-entry block 16% 8%; }
      .hobby__needle {
        animation: hobby-sweep 1ms linear both;
        animation-timeline: --hobby-entry;
        animation-range: entry 5% entry 75%;
      }
    }
  }
  @keyframes arrival {
    from { opacity: .55; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes word-arrival {
    from { transform: translateY(110%); }
    to { transform: translateY(0); }
  }
  @keyframes note-rule {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes note-accent {
    from { color: var(--text); }
    to { color: var(--cyan); }
  }
  @keyframes profile-scan {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @keyframes profile-label {
    from { color: var(--muted); }
    to { color: var(--cyan); }
  }
  @keyframes hobby-sweep {
    from { transform: rotate(-62deg); }
    to { transform: rotate(62deg); }
  }
  @media (max-width: 700px) {
    .vlog-page { --header-height: 68px; }
    .site-header { gap: 4px; }
    .logo__text { display: none; }
    nav { gap: 0; }
    nav a { padding-inline: 6px; font-size: 11px; }
    .hero { background-position: center; background-image: radial-gradient(ellipse at 50% 72%, color-mix(in srgb, var(--cyan) 10%, var(--panel)), var(--ink) 69%); }
    .hero::before { mask-image: radial-gradient(ellipse 74% 53% at 50% 72%, #000 16%, transparent 90%); }
    .hero__layout, .field-note__header, .intro__layout, .hobby__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__cta { flex-direction: column; }
    .field-note__photo { aspect-ratio: 3 / 2; }
  }
  @media (max-width: 360px) {
    nav a { padding-inline: 4px; }
  }
</style>

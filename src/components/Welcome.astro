---
const hobbies = [
  {
    title: 'Sports + Outdoors',
    detail: 'Basketball, swimming, beach walks, and weekend bike rides.',
    extra: 'I like learning one small new move or route every time I head outside.',
  },
  {
    title: 'Games + Building',
    detail: 'LEGO builds, Minecraft creative mode, and puzzle challenges.',
    extra: 'My favorite projects start with a big idea and turn into something surprising.',
  },
  {
    title: 'Curious Stuff',
    detail: 'Space facts, kid science videos, and fun experiments at home.',
    extra: 'If I find a cool question, I usually keep digging until I know the answer.',
  },
];

const adventures = [
  {
    title: 'Aquarium After Dark',
    place: 'Ocean Discovery Hall',
    highlight: 'Watching jellyfish glow like tiny spaceships.',
    lesson: 'The quietest animals can still be the most amazing.',
  },
  {
    title: 'Mountain Train Mission',
    place: 'Cloudline Railway',
    highlight: 'Counting tunnels while the valley disappeared into clouds.',
    lesson: 'A slow journey gives you more time to notice things.',
  },
  {
    title: 'Beach Bike Sunrise',
    place: 'East Bay Boardwalk',
    highlight: 'Racing the sunrise and stopping for warm breakfast buns.',
    lesson: 'Starting early can turn an ordinary day into an adventure.',
  },
];

const navItems = [
  { label: '[M] MEET ME', href: '#introduction' },
  { label: '[H] HOBBIES', href: '#hobby' },
  { label: '[T] TOP', href: '#hero' },
];

const sections = [
  { label: 'HERO', href: '#hero' },
  { label: 'INTRODUCTION', href: '#introduction' },
  { label: 'HOBBY', href: '#hobby' },
  { label: 'ADVENTURES', href: '#adventures' },
];

const featuredAdventure = adventures[0];
---

<main class="vlog-page">
  <canvas class="vlog-scene" data-vlog-scene aria-hidden="true"></canvas>
  <div class="scanlines" aria-hidden="true"></div>

  <header class="topbar" aria-label="Primary">
    <p>SCROLL OR PRESS DOWN AND UP</p>
    <nav>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </header>

  <section class="hero" id="hero" data-section>
    <p class="brand">TT VLOG</p>
    <div class="hero__copy">
      <p class="hero__tag">Personal vlog · Age 11</p>
      <h1>Hi! I share my days, ideas, and mini adventures.</h1>
      <p class="hero__lead">
        This is my little corner to write about trips, school wins, and the fun
        things I learn every week.
      </p>
      <div class="hero__cta">
        <a class="cta" href="#introduction">Meet me</a>
        <a class="cta ghost" href="#hobby">My hobbies</a>
      </div>
    </div>
  </section>

  <aside class="rail" aria-label="Page sections">
    <ol>
      {sections.map((section, index) => (
        <li class={index === 0 ? 'is-active' : ''}>
          <a href={section.href} data-section-link>{section.label}</a>
        </li>
      ))}
    </ol>
  </aside>

  <section class="intro section-band" id="introduction" data-section>
    <div>
      <h2>Introduction</h2>
      <p>
        I am an 11-year-old boy who loves to explore new places, try new food,
        and learn cool facts. I like writing short stories about my day and
        keeping photos of special moments.
      </p>
      <p>
        In this vlog, you will find travel notes, school highlights, and little
        tips I discover while growing up. Thanks for stopping by!
      </p>
    </div>
    <div class="intro__card">
      <h3>Quick facts</h3>
      <ul>
        <li>Favorite color: ocean blue</li>
        <li>Dream trip: giant aquariums + mountain trains</li>
        <li>Best snack: fruit yogurt + crackers</li>
      </ul>
    </div>
  </section>

  <section class="hobby section-band" id="hobby" data-section>
    <header>
      <h2>Hobby</h2>
      <p>These are the things that make my weekends feel awesome.</p>
    </header>
    <div class="hobby__grid">
      {hobbies.map((item) => (
        <article class="hobby__card">
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
          <button
            class="hobby__toggle"
            type="button"
            data-hobby-toggle
            aria-expanded="false"
            aria-controls={`hobby-detail-${item.title.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}
          >
            More about this hobby
          </button>
          <p
            class="hobby__detail"
            id={`hobby-detail-${item.title.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}
            data-hobby-detail
          >
            {item.extra}
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="adventures section-band" id="adventures" data-section>
    <header>
      <h2>Adventures</h2>
      <p>Pick a mission to read the featured vlog log.</p>
    </header>
    <div class="adventures__content">
      <div class="adventures__selectors" aria-label="Adventure missions">
        {adventures.map((adventure, index) => (
          <button
            class="adventure__select"
            type="button"
            data-adventure-select
            data-adventure-title={adventure.title}
            data-adventure-place={adventure.place}
            data-adventure-highlight={adventure.highlight}
            data-adventure-lesson={adventure.lesson}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span>{adventure.title}</span>
            <small>{adventure.place}</small>
          </button>
        ))}
      </div>
      <article class="adventures__featured" aria-live="polite">
        <p class="adventures__eyebrow">FEATURED LOG</p>
        <h3 data-adventure-title>{featuredAdventure.title}</h3>
        <p class="adventures__place" data-adventure-place>{featuredAdventure.place}</p>
        <p data-adventure-highlight>{featuredAdventure.highlight}</p>
        <p class="adventures__lesson" data-adventure-lesson>{featuredAdventure.lesson}</p>
      </article>
    </div>
  </section>
</main>

<script>
  import * as THREE from 'three';

  const canvas = document.querySelector('[data-vlog-scene]');

  if (canvas instanceof HTMLCanvasElement) {
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x020506, 0.055);

    const camera = new THREE.PerspectiveCamera(62, 1, 0.1, 180);
    camera.position.set(0, 8.5, 17);
    camera.lookAt(0, 0.3, -28);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: false,
      powerPreference: 'high-performance',
    });
    renderer.setClearColor(0x020304, 1);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.8));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;

    const pointer = new THREE.Vector2();
    const eased = new THREE.Vector2();

    const makePoints = (count, createPosition, createColor, size) => {
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(count * 3);
      const colors = new Float32Array(count * 3);

      for (let i = 0; i < count; i += 1) {
        const position = createPosition();
        const color = createColor(position);
        const i3 = i * 3;
        positions[i3] = position.x;
        positions[i3 + 1] = position.y;
        positions[i3 + 2] = position.z;
        colors[i3] = color.r;
        colors[i3 + 1] = color.g;
        colors[i3 + 2] = color.b;
      }

      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

      const material = new THREE.PointsMaterial({
        size,
        vertexColors: true,
        transparent: true,
        opacity: 0.92,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        sizeAttenuation: true,
      });

      return new THREE.Points(geometry, material);
    };

    const field = makePoints(
      26000,
      () => {
        const z = -8 - Math.random() * 78;
        const spread = 26 + Math.abs(z) * 1.35;
        return new THREE.Vector3((Math.random() - 0.5) * spread, -1.65, z);
      },
      (position) => {
        const horizon = THREE.MathUtils.clamp((Math.abs(position.z) - 8) / 78, 0, 1);
        const color = new THREE.Color().setHSL(0.26, 0.92, 0.52 + horizon * 0.12);
        if (Math.random() > 0.78) color.setRGB(0.9, 0.98, 1);
        return color;
      },
      0.09
    );
    field.rotation.x = -0.055;
    scene.add(field);

    const stars = makePoints(
      1400,
      () => {
        const radius = 35 + Math.random() * 70;
        const theta = Math.random() * Math.PI * 2;
        const y = 4 + Math.random() * 38;
        return new THREE.Vector3(Math.cos(theta) * radius, y, -Math.abs(Math.sin(theta) * radius) - 12);
      },
      () => new THREE.Color(0.68 + Math.random() * 0.32, 0.86 + Math.random() * 0.14, 0.72 + Math.random() * 0.28),
      0.09
    );
    scene.add(stars);

    const createTrack = (color, width, offset, opacity) => {
      const points = [];
      for (let i = 0; i < 180; i += 1) {
        const t = i / 179;
        const z = 6 - t * 80;
        const curve = Math.sin(t * Math.PI * 1.34 + offset) * (5.2 + t * 16);
        points.push(new THREE.Vector3(curve - 8.5 + t * 16, -1.2 + t * 0.34, z));
      }

      const geometry = new THREE.TubeGeometry(new THREE.CatmullRomCurve3(points), 360, width, 8, false);
      const material = new THREE.MeshBasicMaterial({
        color,
        transparent: true,
        opacity,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });

      return new THREE.Mesh(geometry, material);
    };

    const whiteTrack = createTrack(0xf8fff8, 0.08, 0.05, 0.95);
    const redTrack = createTrack(0xff2c1f, 0.055, 0.18, 0.74);
    const hotTrack = createTrack(0xfff7e6, 0.16, 0.08, 0.34);
    scene.add(whiteTrack, redTrack, hotTrack);

    const horizon = new THREE.Mesh(
      new THREE.PlaneGeometry(180, 18),
      new THREE.MeshBasicMaterial({
        color: 0x96ff3d,
        transparent: true,
        opacity: 0.08,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      })
    );
    horizon.position.set(0, -1.48, -52);
    horizon.rotation.x = -Math.PI / 2;
    scene.add(horizon);

    const redGlow = new THREE.PointLight(0xff392c, 2.2, 38);
    redGlow.position.set(-8, -0.5, -5);
    scene.add(redGlow);

    const resize = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    };

    const onPointerMove = (event) => {
      pointer.x = (event.clientX / window.innerWidth) * 2 - 1;
      pointer.y = -((event.clientY / window.innerHeight) * 2 - 1);
    };

    window.addEventListener('resize', resize);
    window.addEventListener('pointermove', onPointerMove);
    resize();

    const clock = new THREE.Clock();
    const animate = () => {
      const elapsed = clock.getElapsedTime();
      eased.lerp(pointer, 0.045);

      const fieldPositions = field.geometry.attributes.position.array;
      for (let i = 0; i < fieldPositions.length; i += 3) {
        fieldPositions[i + 2] += 0.055;
        if (fieldPositions[i + 2] > 8) fieldPositions[i + 2] = -86;
      }
      field.geometry.attributes.position.needsUpdate = true;

      stars.rotation.y = elapsed * 0.012 + eased.x * 0.025;
      stars.material.opacity = 0.66 + Math.sin(elapsed * 0.8) * 0.18;
      whiteTrack.material.opacity = 0.72 + Math.sin(elapsed * 3.2) * 0.22;
      redTrack.material.opacity = 0.48 + Math.sin(elapsed * 4.1 + 1.4) * 0.22;
      hotTrack.material.opacity = 0.2 + Math.sin(elapsed * 2.3) * 0.12;
      whiteTrack.position.z = Math.sin(elapsed * 1.2) * 0.32;
      redTrack.position.z = Math.cos(elapsed * 1.45) * 0.5;
      horizon.material.opacity = 0.07 + Math.sin(elapsed * 1.4) * 0.035;
      redGlow.position.x = -8 + Math.sin(elapsed * 1.8) * 5;
      redGlow.position.z = -4 - Math.abs(Math.sin(elapsed * 1.15)) * 18;

      camera.position.x = eased.x * 1.1;
      camera.position.y = 8.4 + eased.y * 0.55 + Math.sin(elapsed * 0.42) * 0.12;
      camera.position.z = 17 + Math.sin(elapsed * 0.38) * 0.34;
      camera.lookAt(eased.x * 1.8, 0.1 + eased.y * 0.3, -30);

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    };

    animate();
  }
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@500;600;700&display=swap');

  :global(html) {
    background: #020304;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: #020304;
    color: #f7fff0;
  }

  .vlog-page {
    --acid: #b9fb4b;
    --panel: rgba(17, 22, 17, 0.7);
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    min-height: 180vh;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 56% 47%, rgba(131, 219, 255, 0.26), transparent 26rem),
      linear-gradient(180deg, #020304 0%, #061014 58%, #020304 100%);
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  .vlog-scene,
  .scanlines {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .vlog-scene {
    z-index: 0;
  }

  .scanlines {
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      radial-gradient(circle at 50% 48%, transparent 0 36%, rgba(0, 0, 0, 0.34) 68%, rgba(0, 0, 0, 0.74) 100%);
    background-size: 100% 4px, 100% 100%;
    mix-blend-mode: screen;
    opacity: 0.46;
  }

  .topbar {
    position: fixed;
    z-index: 4;
    inset: 22px 22px auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--mono);
    font-size: 12px;
    color: rgba(220, 232, 235, 0.64);
  }

  .topbar p {
    margin: 0;
  }

  .topbar nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
  }

  .topbar a,
  .cta {
    color: rgba(235, 244, 247, 0.86);
    text-decoration: none;
    background: rgba(32, 40, 45, 0.82);
    border: 1px solid rgba(168, 188, 190, 0.16);
    padding: 8px 10px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .topbar a:hover,
  .cta:hover {
    color: #0a0f0b;
    background: var(--acid);
    transform: translateY(-1px);
  }

  .hero {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: grid;
    grid-template-rows: minmax(150px, 28vh) 1fr;
    align-items: start;
    padding: 86px 32px 0;
    box-sizing: border-box;
  }

  .brand {
    margin: 0;
    color: var(--acid);
    font-family: 'Anton', Impact, sans-serif;
    font-size: clamp(92px, 18vw, 260px);
    line-height: 0.78;
    transform: scaleX(1.22);
    transform-origin: left top;
    text-shadow:
      0 0 22px rgba(185, 251, 75, 0.18),
      0 0 68px rgba(185, 251, 75, 0.16);
    animation: brandIgnition 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    user-select: none;
  }

  .hero__copy {
    width: min(1040px, calc(100vw - 32px));
    justify-self: center;
    align-self: start;
    margin-top: clamp(10px, 8vh, 86px);
    text-align: center;
    animation: copyRise 900ms 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero__tag {
    display: inline-flex;
    margin: 0 0 16px;
    color: var(--acid);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(46px, 6vw, 86px);
    line-height: 0.98;
    color: #fbfff7;
    text-shadow:
      0 0 6px rgba(255, 255, 255, 0.95),
      0 0 20px rgba(236, 255, 248, 0.62),
      0 0 44px rgba(117, 212, 255, 0.34);
  }

  .hero__lead {
    width: min(590px, 100%);
    margin: 22px auto 0;
    color: rgba(235, 244, 247, 0.78);
    font-size: 16px;
    line-height: 1.55;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
  }

  .hero__cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .cta.ghost {
    background: rgba(5, 7, 8, 0.58);
  }

  .rail {
    position: fixed;
    z-index: 4;
    left: 24px;
    bottom: 26px;
    width: 186px;
    padding: 18px 18px 18px 36px;
    box-sizing: border-box;
    background:
      radial-gradient(circle at 12% 10%, rgba(185, 251, 75, 0.22), transparent 36%),
      radial-gradient(circle at 100% 100%, rgba(255, 70, 54, 0.26), transparent 40%),
      var(--panel);
    border: 1px solid rgba(219, 255, 197, 0.08);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 22px 60px rgba(0, 0, 0, 0.38);
  }

  .rail ol {
    list-style: none;
    display: grid;
    gap: 13px;
    padding: 0;
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
  }

  .rail li {
    position: relative;
  }

  .rail li::before {
    content: '';
    position: absolute;
    left: -20px;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(238, 246, 244, 0.8);
    box-shadow: 0 0 8px rgba(238, 246, 244, 0.65);
  }

  .rail li.is-active::before {
    width: 11px;
    height: 11px;
    left: -24px;
    top: 0.18em;
    background: var(--acid);
    box-shadow: 0 0 18px rgba(185, 251, 75, 0.95);
  }

  .rail a {
    color: rgba(240, 246, 242, 0.48);
    text-decoration: none;
  }

  .rail .is-active a {
    color: #f8fff1;
  }

  .section-band {
    position: relative;
    z-index: 2;
    padding: 12vh 8vw;
    background: linear-gradient(180deg, rgba(3, 5, 4, 0.72), rgba(3, 5, 4, 0.94));
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.7fr);
    gap: 42px;
    align-items: start;
  }

  .intro h2,
  .hobby h2,
  .adventures h2 {
    margin: 0 0 18px;
    color: #f8fff2;
    font-size: clamp(40px, 6vw, 84px);
    line-height: 0.98;
    text-shadow: 0 0 28px rgba(185, 251, 75, 0.12);
  }

  .intro p,
  .hobby header p,
  .hobby__card p,
  .adventures header p,
  .adventures__featured p {
    color: rgba(235, 244, 247, 0.74);
    line-height: 1.75;
  }

  .intro__card,
  .hobby__card,
  .adventure__select,
  .adventures__featured {
    background: rgba(17, 22, 17, 0.72);
    border: 1px solid rgba(219, 255, 197, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 22px 60px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(14px);
  }

  .intro__card {
    padding: 24px;
  }

  .intro__card h3,
  .hobby__card h3,
  .adventures__featured h3 {
    margin: 0 0 14px;
    color: var(--acid);
    font-family: var(--mono);
    font-size: 14px;
  }

  .intro__card ul {
    list-style: none;
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 0;
  }

  .intro__card li {
    color: rgba(247, 255, 240, 0.86);
    border-top: 1px solid rgba(219, 255, 197, 0.12);
    padding-top: 12px;
  }

  .hobby header {
    max-width: 760px;
  }

  .hobby__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 30px;
  }

  .hobby__card {
    padding: 22px;
  }

  .hobby__card p {
    margin: 0;
  }

  .hobby__toggle {
    width: 100%;
    min-height: 44px;
    margin-top: 18px;
    color: var(--acid);
    background: rgba(185, 251, 75, 0.06);
    border: 1px solid rgba(185, 251, 75, 0.34);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }

  .hobby__toggle:hover,
  .hobby__toggle[aria-expanded='true'] {
    color: #0a0f0b;
    background: var(--acid);
  }

  .hobby__toggle:focus-visible,
  .adventure__select:focus-visible {
    outline: 3px solid #f8fff1;
    outline-offset: 3px;
  }

  .hobby__detail {
    margin-top: 16px !important;
  }

  :global(.js) .hobby__detail[hidden] {
    display: none;
  }

  .adventures header {
    max-width: 760px;
  }

  .adventures__content {
    display: grid;
    grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1.35fr);
    gap: 18px;
    margin-top: 30px;
  }

  .adventures__selectors {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .adventure__select {
    width: 100%;
    min-height: 64px;
    padding: 14px 16px;
    color: rgba(247, 255, 240, 0.84);
    text-align: left;
    font-family: var(--mono);
    cursor: pointer;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .adventure__select span,
  .adventure__select small {
    display: block;
  }

  .adventure__select span {
    font-size: 12px;
    font-weight: 700;
  }

  .adventure__select small {
    margin-top: 6px;
    color: rgba(235, 244, 247, 0.56);
    font-size: 10px;

---
import MotionScene from './MotionScene.astro';

const navItems = [
  { label: 'Meet me', href: '#introduction' },
  { label: 'Hobbies', href: '#hobby' },
  { label: 'Home', href: '#hero' },
];

const facts = [
  { label: 'Favorite color', value: 'Ocean blue', tone: 'cyan' },
  { label: 'Dream trip', value: 'Aquariums + mountain trains', tone: 'gold' },
  { label: 'Best snack', value: 'Fruit yogurt + crackers', tone: 'green' },
];

const hobbies = [
  {
    title: 'Sports + Outdoors',
    detail: 'Basketball, swimming, beach walks, and weekend bike rides.',
    metric: 'Move',
    status: 'active',
  },
  {
    title: 'Games + Building',
    detail: 'LEGO builds, Minecraft creative mode, and puzzle challenges.',
    metric: 'Build',
    status: 'creative',
  },
  {
    title: 'Curious Stuff',
    detail: 'Space facts, kid science videos, and fun experiments at home.',
    metric: 'Learn',
    status: 'scanning',
  },
];
---

<main class="vlog-page">
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="site-header">
    <a class="logo" href="#hero" aria-label="TT Vlog home">
      <span class="logo__mark">TT</span>
      <span class="logo__text">Vlog OS</span>
    </a>
    <nav aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" aria-pressed="false">
      <span class="theme-toggle__track" aria-hidden="true">
        <span class="theme-toggle__thumb"></span>
      </span>
      <span class="theme-toggle__text" data-theme-label>Dark</span>
    </button>
  </header>

  <section class="hero" id="hero">
    <div class="hero__copy">
      <p class="eyebrow">Personal vlog · Mission log · Age 11</p>
      <h1>TT Vlog<span>Small adventures.<br />Big discoveries.</span></h1>
      <p class="hero__lead">
        A small digital base for travel notes, school wins, hobbies, and the cool
        things I learn every week.
      </p>
      <div class="hero__cta" aria-label="Page shortcuts">
        <a class="cta cta--primary" href="#introduction">Open profile</a>
        <a class="cta" href="#hobby">Explore hobbies <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero-motion"><MotionScene /></div>
  </section>

  <section class="intro section-band" id="introduction">
    <div class="section-copy">
      <p class="eyebrow">Profile scan</p>
      <h2>Introduction</h2>
      <p>
        I am an 11-year-old boy who loves to explore new places, try new food,
        and learn cool facts. I like writing short stories about my day and
        keeping photos of special moments.
      </p>
      <p>
        In this vlog, you will find travel notes, school highlights, and little
        tips I discover while growing up. Thanks for stopping by!
      </p>
    </div>

    <div class="profile-panel">
      <div class="panel-topline">
        <span>PROFILE-ID TT-011</span>
        <span>SYNCED</span>
      </div>
      <MotionScene variant="signal" label="TT / PROFILE" />
    </div>

    <div class="facts-grid" aria-label="Quick facts">
      {facts.map((fact) => (
        <article class={`fact-card fact-card--${fact.tone}`}>
          <span>{fact.label}</span>
          <strong>{fact.value}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="hobby section-band" id="hobby">
    <header class="section-copy">
      <p class="eyebrow">Weekend telemetry</p>
      <h2>Off the clock.<br />Into the curious.</h2>
      <p>These are the things that make my weekends feel awesome.</p>
    </header>

    <div class="hobby__grid">
      {hobbies.map((item, index) => (
        <article class="hobby__card">
          <div class="hobby__dial" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div>
            <p class="hobby__metric">{item.metric}</p>
            <h3>{item.title}</h3>
          </div>
          <p>{item.detail}</p>
          <footer>
            <span>Status</span>
            <strong>{item.status}</strong>
          </footer>
        </article>
      ))}
    </div>
  </section>
  <footer class="site-footer"><a href="#hero">TT Vlog <span aria-hidden="true">↑</span></a><span>Stay curious. Keep exploring.</span></footer>
</main>

<script>
  import { animate } from 'animejs';
  const themeToggle = document.querySelector('[data-theme-toggle]');
  const themeLabel = document.querySelector('[data-theme-label]');

  const syncThemeToggle = () => {
    const isLight = document.documentElement.dataset.theme === 'light';
    themeToggle?.setAttribute('aria-pressed', String(isLight));
    themeToggle?.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
    if (themeLabel) {
      themeLabel.textContent = isLight ? 'Light' : 'Dark';
    }
  };

  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem('theme', nextTheme);
    syncThemeToggle();
  });

  syncThemeToggle();

  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Seek paused animations from scroll position so upward scrolling reverses them.
  const scrollItems = [...document.querySelectorAll<HTMLElement>('.section-copy, .profile-panel, .fact-card, .hobby__card, .site-footer')].map((element) => {
    const isCard = element.matches('.fact-card, .hobby__card');
    const index = isCard ? [...element.parentElement!.children].indexOf(element) : 0;
    element.classList.add('scroll-linked');
    return {
      element,
      top: 0,
      delay: index * 0.055,
      animation: animate(element, {
        y: [isCard ? 90 : 48, 0],
        opacity: [0.35, 1],
        scale: [isCard ? 0.94 : 1, 1],
        rotate: [isCard ? (index - 1) * 2 : 0, 0],
        duration: 1000,
        ease: 'outCubic',
        autoplay: false,
      }),
    };
  });
  const sections = [...document.querySelectorAll<HTMLElement>('main > section')].map((element) => ({ element, top: 0, height: 0 }));
  const heroMotion = document.querySelector<HTMLElement>('.hero-motion')!;
  const heroParallax = animate(heroMotion, { y: [0, 100], rotate: [0, 18], scale: [1, 0.86], duration: 1000, ease: 'linear', autoplay: false });
  const dials = [...document.querySelectorAll<HTMLElement>('.hobby__dial')].map((element) => ({
    element,
    animation: animate(element, { rotate: [-140, 0], duration: 1000, ease: 'outCubic', autoplay: false }),
  }));
  const clampProgress = (value: number) => Math.min(1, Math.max(0, value));
  const documentTop = (element: HTMLElement) => {
    let top = 0;
    let current: HTMLElement | null = element;
    while (current) { top += current.offsetTop; current = current.offsetParent as HTMLElement | null; }
    return top;
  };
  const measure = () => {
    scrollItems.forEach((item) => { item.top = documentTop(item.element); });
    sections.forEach((item) => { item.top = documentTop(item.element); item.height = item.element.offsetHeight; });
  };

  const progress = document.querySelector<HTMLElement>('.reading-progress');
  let scrollFrame = 0;
  const updateProgress = () => {
    const distance = document.documentElement.scrollHeight - window.innerHeight;
    progress?.style.setProperty('--progress', String(distance > 0 ? window.scrollY / distance : 0));
    const viewport = window.innerHeight;
    scrollItems.forEach((item) => {
      const start = item.top - viewport * (0.98 - item.delay);
      const end = Math.min(start + viewport * 0.48, distance);
      const position = (window.scrollY - start) / Math.max(1, end - start);
      item.animation.seek((motion.matches ? 1 : clampProgress(position)) * 1000);
    });
    sections.forEach((item) => {
      const position = clampProgress((window.scrollY + viewport - item.top) / (viewport + item.height));
      item.element.style.setProperty('--section-progress', String(motion.matches ? 1 : position));
      item.element.style.setProperty('--grid-shift', `${motion.matches ? 0 : position * 52}px`);
    });
    heroParallax.seek(motion.matches ? 0 : clampProgress(window.scrollY / Math.max(sections[0].height, 1)) * 1000);
    dials.forEach((item) => {
      const position = clampProgress((window.scrollY + viewport * 0.95 - documentTop(item.element)) / (viewport * 0.6));
      item.animation.seek((motion.matches ? 1 : position) * 1000);
    });
    scrollFrame = 0;
  };
  window.addEventListener('scroll', () => {
    if (!scrollFrame) scrollFrame = requestAnimationFrame(updateProgress);
  }, { passive: true });
  window.addEventListener('resize', () => { measure(); updateProgress(); });
  motion.addEventListener('change', updateProgress);
  window.addEventListener('load', () => { measure(); updateProgress(); }, { once: true });
  measure();
  updateProgress();

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a');
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      navLinks.forEach((link) => {
        if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    });
  }, { rootMargin: '-15% 0px -55% 0px' });
  document.querySelectorAll('main > section').forEach((section) => sectionObserver.observe(section));

  document.querySelectorAll<HTMLElement>('.hobby__card').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      if (motion.matches || event.pointerType !== 'mouse') return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
      card.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
    });
  });
</script>

<style>
  :global(html) {
    background: #070b10;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: #070b10;
    color: #f3f7f4;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .vlog-page {
    --ink: #070b10;
    --panel: #101923;
    --panel-strong: #142433;
    --text: #f3f7f4;
    --muted: #9fb3b3;
    --cyan: #27f0d0;
    --blue: #4d8dff;
    --gold: #ffc84a;
    --green: #84ff64;
    --coral: #ff6262;
    --line: rgba(132, 255, 228, 0.22);
    --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    min-height: 100vh;
    background:
      linear-gradient(rgba(39, 240, 208, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(39, 240, 208, 0.045) 1px, transparent 1px),
      linear-gradient(135deg, #070b10 0%, #101923 48%, #1d1717 100%);
    background-size: 36px 36px, 36px 36px, auto;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  :global(html[data-theme='light']) {
    background: #edf7f8;
  }

  :global(html[data-theme='light'] body) {
    background: #edf7f8;
    color: #102330;
  }

  :global(html[data-theme='light']) .vlog-page {
    --ink: #edf7f8;
    --panel: #ffffff;
    --panel-strong: #dff1f3;
    --text: #102330;
    --muted: #526972;
    --cyan: #008f82;
    --blue: #245fc8;
    --gold: #a36a00;
    --green: #287a22;
    --coral: #c13c3c;
    --line: rgba(0, 143, 130, 0.22);
    background:
      linear-gradient(rgba(0, 143, 130, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 143, 130, 0.075) 1px, transparent 1px),
      linear-gradient(135deg, #f6fbfc 0%, #e7f3f5 48%, #fff5ec 100%);
    background-size: 36px 36px, 36px 36px, auto;
  }

  .site-header {
    position: fixed;
    z-index: 20;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px clamp(18px, 4vw, 42px);
    background: rgba(7, 11, 16, 0.72);
    border-bottom: 1px solid rgba(39, 240, 208, 0.16);
    backdrop-filter: blur(16px);
  }

  :global(html[data-theme='light']) .site-header {
    background: rgba(246, 251, 252, 0.78);
    border-bottom-color: rgba(0, 143, 130, 0.2);
  }

  .logo,
  .site-header nav a,
  .cta,
  .theme-toggle {
    min-height: 44px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .logo__mark {
    display: inline-grid;
    place-items: center;
    width: 44px;
    aspect-ratio: 1;
    border: 1px solid rgba(39, 240, 208, 0.56);
    border-radius: 12px;
    color: var(--cyan);
    background: rgba(39, 240, 208, 0.08);
    font-family: var(--mono);
    font-weight: 800;
  }

  .logo__text,
  .site-header nav a,
  .eyebrow,
  .cta,
  .panel-topline,
  .fact-card span,
  .hobby__metric,
  .hobby__card footer {
    font-family: var(--mono);
  }

  .logo__text {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .site-header nav a {
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border: 1px solid transparent;
    color: #c9d7d6;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    color: var(--text);
    border-color: rgba(39, 240, 208, 0.34);
    outline: none;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    border: 1px solid rgba(39, 240, 208, 0.34);
    border-radius: 999px;
    color: #c9d7d6;
    background: rgba(16, 25, 35, 0.78);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 800;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .theme-toggle__track {
    display: inline-flex;
    align-items: center;
    width: 40px;
    height: 22px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(39, 240, 208, 0.18);
  }

  .theme-toggle__thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 12px rgba(39, 240, 208, 0.7);
    transition: transform 180ms ease, background 180ms ease;
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__thumb {
    transform: translateX(18px);
  }

  :global(html[data-theme='light']) .site-header nav a,
  :global(html[data-theme='light']) .theme-toggle {
    color: #28444e;
  }

  :global(html[data-theme='light']) .theme-toggle {
    background: rgba(255, 255, 255, 0.78);
    border-color: rgba(0, 143, 130, 0.28);
  }

  :global(html[data-theme='light']) .theme-toggle__track {
    background: rgba(0, 143, 130, 0.16);
  }

  .hero,
  .section-band {
    min-height: 100dvh;
    position: relative;
    overflow: hidden;
    padding: clamp(92px, 9vw, 124px) clamp(20px, 6vw, 76px) clamp(64px, 8vw, 96px);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(360px, 1.1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
    min-height: 94dvh;
  }

  .hero::after,
  .section-band::after {
    content: '';
    position: absolute;
    left: clamp(20px, 6vw, 76px);
    right: clamp(20px, 6vw, 76px);
    bottom: 34px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(39, 240, 208, 0.7), transparent);
  }

  :global(html[data-theme='light']) .hero::after,
  :global(html[data-theme='light']) .section-band::after {
    background: linear-gradient(90deg, transparent, rgba(0, 143, 130, 0.5), transparent);
  }

  .hero__copy,
  .section-copy,
  .hero-visual,
  .profile-panel,
  .facts-grid,
  .hobby__grid {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--cyan);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 720px;
    margin-bottom: 24px;
    color: var(--text);
    font-size: clamp(44px, 8vw, 96px);
    line-height: 0.92;
    letter-spacing: 0;
  }

  h2 {
    max-width: 560px;
    margin-bottom: 20px;
    color: var(--text);
    font-size: clamp(34px, 6vw, 72px);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .hero__lead,
  .section-copy p {
    max-width: 560px;
    color: #c9d7d6;
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 650;
    line-height: 1.55;
  }

  :global(html[data-theme='light']) .hero__lead,
  :global(html[data-theme='light']) .section-copy p,
  :global(html[data-theme='light']) .hobby__card p {
    color: #38525c;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid rgba(39, 240, 208, 0.38);
    border-radius: 12px;
    color: var(--text);
    background: rgba(16, 25, 35, 0.78);
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  :global(html[data-theme='light']) .cta {
    color: #102330;
    background: rgba(255, 255, 255, 0.78);
    border-color: rgba(0, 143, 130, 0.24);
  }

  .cta:hover,
  .cta:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(39, 240, 208, 0.9);
    outline: none;
  }

  .cta--primary {
    color: #06110f;
    background: linear-gradient(135deg, var(--cyan), var(--green));
    border-color: transparent;
  }

  :global(html[data-theme='light']) .cta--primary {
    color: #f7fffe;
    background: linear-gradient(135deg, #008f82, #245fc8);
  }

  .hero-visual {
    margin: 0;
  }

  .hero-visual img,
  .profile-panel img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-visual img {
    aspect-ratio: 9 / 7;
    object-fit: cover;
    border: 1px solid rgba(39, 240, 208, 0.36);
    border-radius: 24px;
    background: var(--panel);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.34);
  }

  :global(html[data-theme='light']) .hero-visual img,
  :global(html[data-theme='light']) .profile-panel img {
    filter: saturate(0.94) brightness(1.06);
  }

  :global(html[data-theme='light']) .hero-visual img {
    box-shadow: 0 24px 60px rgba(28, 74, 90, 0.18);
  }

  .hero-visual figcaption {
    margin-top: 14px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    text-align: right;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(360px, 1fr);
    grid-template-rows: auto auto;
    gap: clamp(24px, 4vw, 48px);
    background:
      linear-gradient(rgba(77, 141, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(77, 141, 255, 0.04) 1px, transparent 1px),
      linear-gradient(135deg, #0b1017, #121d28 52%, #171411);
    background-size: 30px 30px, 30px 30px, auto;
  }

  :global(html[data-theme='light']) .intro {
    background:
      linear-gradient(rgba(36, 95, 200, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(36, 95, 200, 0.075) 1px, transparent 1px),
      linear-gradient(135deg, #f8fcfd, #e9f5f7 52%, #fff7ec);
    background-size: 30px 30px, 30px 30px, auto;
  }

  .profile-panel {
    align-self: center;
    border: 1px solid rgba(39, 240, 208, 0.3);
    border-radius: 24px;
    padding: 14px;
    background: rgba(8, 15, 20, 0.58);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.28);
  }

  :global(html[data-theme='light']) .profile-panel {
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(0, 143, 130, 0.24);
    box-shadow: 0 22px 50px rgba(28, 74, 90, 0.16);
  }

  .panel-topline {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 4px 6px 14px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
  }

  .facts-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .fact-card,
  .hobby__card {
    border: 1px solid rgba(39, 240, 208, 0.28);
    border-radius: 18px;
    background:
      linear-gradient(90deg, transparent 0 92%, rgba(39, 240, 208, 0.07) 92%),
      linear-gradient(180deg, rgba(16, 25, 35, 0.92), rgba(11, 16, 23, 0.78));
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.24);
  }

  :global(html[data-theme='light']) .fact-card,
  :global(html[data-theme='light']) .hobby__card {
    border-color: rgba(0, 143, 130, 0.22);
    background:
      linear-gradient(90deg, transparent 0 92%, rgba(0, 143, 130, 0.065) 92%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(230, 244, 247, 0.78));
    box-shadow: 0 18px 34px rgba(28, 74, 90, 0.14);
  }

  .fact-card {
    min-height: 132px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .fact-card span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .fact-card strong {
    color: var(--text);
    font-size: clamp(20px, 3vw, 30px);
    line-height: 1.1;

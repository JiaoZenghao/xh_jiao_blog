---
interface Props { compact?: boolean; label?: string; variant?: 'orbit' | 'signal'; }
const { compact = false, label = 'TT / EXPLORER', variant = 'orbit' } = Astro.props;
---

<div class:list={['motion-scene', { 'motion-scene--compact': compact, 'motion-scene--signal': variant === 'signal' }]} data-motion-scene data-variant={variant}>
  <div class="motion-art" aria-hidden="true">
    {variant === 'signal' ? <div class="signal-art">
      <div class="signal-heading"><span>01 / FREQUENCY</span><span>TT-011</span></div>
      <div class="signal-wave">
        {Array.from({ length: 48 }, (_, index) => <span class="signal-bar" style={`height: ${18 + Math.pow(Math.sin(index * 0.29), 2) * 72}%`} />)}
        <div class="signal-cursor"></div>
      </div>
      <div class="signal-streams">
        {['EXPLORE', 'BUILD', 'LEARN'].map((label, index) => <div class="signal-channel">
          <span>{label}</span>
          <div class="signal-track">
            {Array.from({ length: 5 }, (_, packet) => <i class="signal-packet" style={`--packet: ${packet}; --channel: ${index}`} />)}
          </div>
          <span class="signal-index">0{index + 1}</span>
        </div>)}
      </div>
    </div> : <>
    <div class="motion-ring motion-ring--outer"></div>
    <div class="motion-ticks"></div>
    <div class="motion-ring motion-ring--inner"></div>
    <div class="motion-orbit"><span></span><span></span></div>
    <div class="motion-grid">
      {Array.from({ length: 121 }, (_, index) => (
        <span class="motion-cell" style={`--column: ${index % 11}; --row: ${Math.floor(index / 11)}`} />
      ))}
    </div>
    <span class="motion-cross motion-cross--top">+</span>
    <span class="motion-cross motion-cross--bottom">+</span>
    </>}
  </div>
  <div class="motion-controls">
    <span class="motion-label">{label}</span>
    <button type="button" data-motion-pause aria-pressed="false">Pause animation</button>
    <button type="button" data-motion-replay>Replay</button>
  </div>
</div>

<script>
  import { animate, createTimeline, stagger } from 'animejs';

  document.querySelectorAll<HTMLElement>('[data-motion-scene]').forEach((scene) => {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const pauseButton = scene.querySelector<HTMLButtonElement>('[data-motion-pause]')!;
    const replayButton = scene.querySelector<HTMLButtonElement>('[data-motion-replay]')!;
    const cells = scene.querySelectorAll('.motion-cell');
    const grid = scene.querySelector('.motion-grid')!;
    const art = scene.querySelector<HTMLElement>('.motion-art')!;
    let manuallyPaused = false;
    let inView = false;

    const isSignal = scene.dataset.variant === 'signal';
    const sequence = isSignal
      ? createTimeline({ loop: true, autoplay: false, defaults: { ease: 'inOutSine' } })
        .add(scene.querySelectorAll('.signal-bar'), { scaleY: [0.2, 1, 0.4, 0.85, 0.2], opacity: [0.4, 1, 0.6, 1, 0.4], duration: 3400, delay: stagger(45) }, 0)
        .add(scene.querySelector('.signal-cursor')!, { left: ['0%', '100%'], opacity: [0, 0.8, 0.8, 0], duration: 5400, ease: 'linear' }, 0)
        .add(scene.querySelectorAll('.signal-packet'), { left: ['-8%', '108%'], opacity: [0, 1, 1, 0], duration: 2400, delay: stagger(210), ease: 'linear' }, 0)
      : createTimeline({ loop: true, autoplay: false, defaults: { ease: 'inOutSine' } })
      .add(cells, {
        scale: [0.35, 1], opacity: [0.3, 1], rotate: [0, 90],
        duration: 1200, delay: stagger(45, { grid: [11, 11], from: 'center' }),
      }, 0)
      .add(grid, { rotate: [0, 90], duration: 2600 }, 1000)
      .add(cells, {
        borderRadius: ['2px', '50%'], scale: [1, 0.5],
        duration: 1100, delay: stagger(35, { grid: [11, 11], from: 'center' }),
      }, 2500)
      .add(cells, {
        x: (_el, index) => (index % 11 - 5) * 3,
        y: (_el, index) => (Math.floor(index / 11) - 5) * 3,
        scale: [0.5, 0.85], duration: 1400,
        delay: stagger(30, { grid: [11, 11], from: 'center' }),
      }, 4000)
      .add(cells, { x: 0, y: 0, borderRadius: '2px', scale: 0.35, opacity: 0.3, rotate: 0, duration: 1300, delay: stagger(12) }, 6200)
      .add(grid, { rotate: 180, duration: 1800 }, 6000);

    const animations = isSignal ? [sequence] : [sequence,
      animate(scene.querySelector('.motion-ring--outer')!, { rotate: 360, duration: 28000, ease: 'linear', loop: true, autoplay: false }),
      animate(scene.querySelector('.motion-ring--inner')!, { rotate: -360, duration: 18000, ease: 'linear', loop: true, autoplay: false }),
      animate(scene.querySelector('.motion-orbit')!, { rotate: 360, duration: 9500, ease: 'linear', loop: true, autoplay: false }),
    ];

    const syncPlayback = () => {
      const paused = manuallyPaused || reducedMotion.matches;
      const running = !paused && inView && !document.hidden;
      animations.forEach((animation) => running ? animation.resume() : animation.pause());
      pauseButton.textContent = paused ? 'Play animation' : 'Pause animation';
      pauseButton.setAttribute('aria-pressed', String(paused));
      pauseButton.disabled = reducedMotion.matches;
      replayButton.disabled = reducedMotion.matches;
      if (reducedMotion.matches) {
        animations.forEach((animation) => animation.seek(0));
        art.style.removeProperty('transform');
      }
    };
    pauseButton.addEventListener('click', () => { manuallyPaused = !manuallyPaused; syncPlayback(); });
    replayButton.addEventListener('click', () => {
      animations.forEach((animation) => animation.seek(0));
      manuallyPaused = false;
      syncPlayback();
    });
    const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; syncPlayback(); }, { threshold: 0.05 });
    observer.observe(scene);
    document.addEventListener('visibilitychange', syncPlayback);
    reducedMotion.addEventListener('change', syncPlayback);
    syncPlayback();

    scene.addEventListener('pointermove', (event) => {
      if (reducedMotion.matches || manuallyPaused || event.pointerType !== 'mouse') return;
      const bounds = scene.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      art.style.transform = `perspective(900px) rotateX(${-y * 12}deg) rotateY(${x * 12}deg)`;
    });
    scene.addEventListener('pointerleave', () => { art.style.removeProperty('transform'); });
  });
</script>

<style>
  .motion-scene { width: 100%; position: relative; min-width: 0; }
  .motion-art { width: min(100%, 520px); aspect-ratio: 1; position: relative; margin: auto; transition: transform 400ms ease-out; }
  .motion-scene--compact .motion-art { max-width: 380px; }
  .motion-scene--signal .motion-art { max-width: none; aspect-ratio: 1.45; }
  .signal-art { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 22px; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .signal-heading { display: flex; justify-content: space-between; font: 10px ui-monospace, monospace; color: var(--muted); }
  .signal-wave { display: flex; align-items: center; gap: 4px; position: relative; flex: 1; min-height: 70px; overflow: hidden; background: repeating-linear-gradient(0deg, transparent 0 23px, var(--line) 24px 24.5px); }
  .signal-bar { flex: 1; min-width: 0; background: var(--cyan); transform-origin: center; border-radius: 2px; }
  .signal-bar:nth-child(3n) { background: var(--blue); }
  .signal-bar:nth-child(7n) { background: var(--gold); }
  .signal-cursor { position: absolute; inset: 0 auto 0 0; width: 2px; background: var(--coral); box-shadow: 0 0 12px var(--coral); }
  .signal-streams { display: grid; gap: 17px; transform: translateX(calc((var(--section-progress, .5) - .5) * 12px)); }
  .signal-channel { display: grid; grid-template-columns: 70px 1fr 20px; align-items: center; gap: 14px; font: 10px ui-monospace, monospace; color: var(--muted); }
  .signal-track { position: relative; height: 14px; overflow: hidden; background: linear-gradient(transparent 6px, var(--line) 6px 7px, transparent 7px); }
  .signal-packet { position: absolute; top: 2px; left: calc(var(--packet) * 20%); width: 18px; height: 9px; border: 1px solid var(--cyan); background: var(--panel); }
  .signal-channel:nth-child(2) .signal-packet { border-color: var(--gold); }
  .signal-channel:nth-child(3) .signal-packet { border-color: var(--coral); }
  .signal-index { color: var(--cyan); }
  .motion-ring, .motion-ticks, .motion-orbit { position: absolute; border-radius: 50%; }
  .motion-ring--outer { inset: 3%; border: 3px solid transparent; border-top-color: var(--cyan); border-right-color: var(--gold); border-bottom-color: var(--coral); }
  .motion-ring--outer::after { content: ''; position: absolute; inset: 9px; border: 1px solid var(--line); border-radius: 50%; }
  .motion-ring--inner { inset: 12%; border: 7px solid transparent; border-top-color: var(--line); border-bottom-color: var(--cyan); opacity: .65; }
  .motion-ticks { inset: 7%; background: repeating-conic-gradient(var(--muted) 0deg 0.5deg, transparent 0.5deg 3deg); mask: radial-gradient(transparent 67%, black 67.5%, black 70%, transparent 70.5%); opacity: .55; }
  .motion-orbit { inset: 17%; border: 1px solid var(--line); }
  .motion-orbit span { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--coral); top: calc(50% - 5px); left: -5px; }
  .motion-orbit span + span { left: auto; right: -5px; background: var(--gold); }
  .motion-grid { position: absolute; inset: 26%; display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); gap: 5px; }
  .motion-cell { display: block; aspect-ratio: 1; border-radius: 2px; background: var(--cyan); opacity: .65; }
  .motion-cell:nth-child(3n) { background: var(--gold); }
  .motion-cell:nth-child(5n) { background: var(--coral); }
  .motion-cross { position: absolute; font: 20px ui-monospace, monospace; color: var(--muted); }
  .motion-cross--top { top: 5%; right: 5%; }
  .motion-cross--bottom { bottom: 5%; left: 5%; }
  .motion-controls { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 16px; font: 10px ui-monospace, monospace; color: var(--muted); }
  button { color: var(--text); background: transparent; border: 1px solid var(--line); padding: 10px; min-height: 44px; border-radius: 4px; cursor: pointer; font: inherit; }
  button:hover { border-color: var(--cyan); }
  button:focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; }
  button:disabled { opacity: .45; cursor: default; }
  @media (max-width: 700px) { .motion-grid { gap: 3px; } .motion-controls { gap: 8px; } .motion-label { font-size: 9px; } }
  @media (max-width: 700px) { .motion-scene--signal .motion-art { aspect-ratio: 1.1; } .signal-art { gap: 16px; padding: 18px 0; } .signal-wave { gap: 3px; } .signal-channel { gap: 8px; grid-template-columns: 60px 1fr 18px; } }
  @media (prefers-reduced-motion: reduce) { .motion-art { transition: none; } }
</style>
